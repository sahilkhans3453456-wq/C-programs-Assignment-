Write a C++ program that takes the remaining exam time in minutes as input. If 5 minutes or less 
remain, display "Warning: Exam Is About to End".

#include<iostream>
using namespace std;

int main()
{ float T;
cout<<" Online Exam Time in minutes "<<endl;
cin>>T;
if (T<=5)
cout<<"Warning: Exam is about to end!!!";
    return 0;
}
