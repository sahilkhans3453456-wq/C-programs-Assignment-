Write a C++ program that takes the number of hours a vehicle has been parked and whether the 
driver has a valid student ID (1 for yes, 0 for no). If the driver has a valid student ID and parks 
for at least 2 hours, display "Student Parking Discount Applicable".
#include<iostream>
using namespace std;

int main()
{
    float hours;
    int studentID;
    
    cout<<"Enter Parking Hours and Student ID (1 for Yes, 0 for No)"<<endl;
    cin>>hours>>studentID;

    if (studentID==1 && hours>=2)
    {
        cout<<"Student Parking Discount Applicable";
    }
    else
    {
        cout<<"No Discount";
    }

    return 0;
}